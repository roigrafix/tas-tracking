# TAS Tracking Server — Environment Variables
# ============================================
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# JWT — generate a strong random secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# reCAPTCHA v2 — SECRET key (never expose in frontend)
RECAPTCHA_SECRET_KEY=6Lc3__YsAAAAAOoMPhZSUCHpML1HayX24imsiIee

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database file path (relative to server root)
DB_PATH=./data/tas.db
